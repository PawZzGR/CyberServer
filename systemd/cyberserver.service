[Unit]
Description=CyberServer Main Server
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=DISPLAY=:0
WorkingDirectory=/opt/cyberserver/Server
ExecStart=/usr/bin/python3 /opt/cyberserver/Server/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
